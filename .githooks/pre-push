#!/usr/bin/env bash
# 防呆最後一道牆：阻擋將 .no-merge 中的路徑推上受保護分支（預設 main）。
# 啟用：git config core.hooksPath .githooks
#
# 即使有人忘了用 merge-to-main.sh、直接 git merge 再 push，此 hook 仍會擋下。
set -uo pipefail

PROTECTED="main"
ROOT="$(git rev-parse --show-toplevel)"
NOMERGE="$ROOT/.no-merge"
[ -f "$NOMERGE" ] || exit 0

# 把清單轉成 grep 用的 regex（跳脫特殊字元，以 | 串接）
PATTERN="$(grep -vE '^[[:space:]]*(#|$)' "$NOMERGE" \
  | sed 's/[[:space:]]*$//' \
  | sed 's/[.[\*^$]/\\&/g' \
  | paste -sd '|' - || true)"
[ -n "$PATTERN" ] || exit 0

ZERO="$(printf '%040d' 0)"
fail=0

while read -r _local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/$PROTECTED" ] || continue
  [ "$local_sha" = "$ZERO" ] && continue          # 刪除分支，略過

  if [ "$remote_sha" = "$ZERO" ]; then            # 遠端尚無此分支（首推）
    base="$(git merge-base "$local_sha" "origin/$PROTECTED" 2>/dev/null || true)"
    range="${base:+$base..}$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  hits="$(git diff --name-only $range 2>/dev/null | grep -E "^($PATTERN)" || true)"
  if [ -n "$hits" ]; then
    echo "❌ 推送遭阻擋：下列路徑不得進入 $PROTECTED 分支"
    echo "$hits" | sed 's/^/   - /'
    fail=1
  fi
done

[ "$fail" -eq 0 ] || {
  echo
  echo "→ 這些是 dev_ai 專屬的隔離檔案。請改用 scripts/merge-to-main.sh 合併，"
  echo "  它會在進入 $PROTECTED 前自動剝離這些路徑。"
}
exit "$fail"
