# 複製本檔為專案根目錄的 .env 後填入實際值：cp example_file/.env.example .env
# .env 不納入版本控制。

# API 金鑰（或相容供應商的 key）。agent YAML 以 ${oc.env:OPENAI_API_KEY} 取用；
# 未在 YAML 明寫 api_key 時，OpenAI SDK 也會自動從此變數讀取。
OPENAI_API_KEY=""

# agents 設定 YAML 的路徑，供 create_agent_factory() 讀取。
YAML_SETTINGS_FILE=""

# 最大並發請求數，預設 6。對應 limits_parameters.global_sem。
GLOBAL_CONCURRENCY=6

# 全域每分鐘請求上限，預設 200。對應 limits_parameters.global_rpm_limiter。
RPM=200

# 全域每分鐘 token 上限，預設 30000。
# 註：目前讀入 GLOBAL_TPM 後無任何使用點（umbrella 預設為 NoopUmbrella），
#     保留或移除待 Phase 3 決定，見 docs/project-overview.md 環境變數表。
TPM=30000

# 本地 Ollama 的 OpenAI-compatible endpoint，供多模態測試用。
# 未設定時 tests/multimodal_agents_setup.yaml 會套用預設 http://localhost:11434/v1。
OLLAMA_BASE_URL="http://localhost:11434/v1"

# Ollama 不驗證金鑰，但 AsyncOpenAI 要求非空字串，故給任意佔位值。
OLLAMA_API_KEY="ollama"
